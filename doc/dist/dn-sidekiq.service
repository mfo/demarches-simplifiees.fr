[Unit]
Description="demarche-numerique async jobs processor"
After=syslog.target network.target

[Service]
Type=notify
NotifyAccess=all
User=dn
WorkingDirectory=/var/www/dn
ExecStart=/home/dn/.rbenv/shims/bundle exec sidekiq
Environment="RAILS_ENV=production"
Environment="MALLOC_ARENA_MAX=2"
WatchdogSec=10
RestartSec=1
Restart=always
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dn-sidekiq

[Install]
WantedBy=multi-user.target
