<%# locals: selected (scopes checked), error (message or nil) %>
<fieldset
  class="fr-fieldset <%= 'fr-fieldset--error' if error.present? %>"
  id="api-token-scopes"
  <%= 'aria-describedby=api-token-scopes-error' if error.present? %>
>
  <legend class="fr-fieldset__legend fr-text--regular">
    <%= t('administrateurs.api_tokens.scopes.legend') %>

    <span class="fr-hint-text">
      <%= t('administrateurs.api_tokens.scopes.legend_hint') %>
    </span>
  </legend>

  <% APIToken::SCOPES.each do |scope| %>
    <div class="fr-fieldset__element">
      <div class="fr-checkbox-group">
        <%= check_box_tag 'scopes[]', scope, selected.include?(scope),
          id: "scopes_#{scope}",
          'aria-describedby': "scopes_#{scope}_hint" %>

        <label class="fr-label" for="scopes_<%= scope %>">
          <%= t("administrateurs.api_tokens.scopes.#{scope}.label") %>

          <span class="fr-hint-text" id="scopes_<%= scope %>_hint">
            <%= t("administrateurs.api_tokens.scopes.#{scope}.hint") %>
          </span>
        </label>
      </div>
    </div>
  <% end %>

  <% if error.present? %>
    <div
      class="fr-messages-group"
      id="api-token-scopes-error"
      aria-live="polite"
    >
      <p class="fr-message fr-message--error"><%= error %></p>
    </div>
  <% end %>
</fieldset>
