<div id="url-validation-feedback">
  <% if referentiel.errors.where(:url).present? %>
    <%= render Dsfr::AlertComponent.new(state: :warning, title: nil, size: :sm, heading_level: :p, extra_class_names: 'fr-mt-2w') do |c| %>
      <% c.with_body do %>
        <p>
          Pour des raisons de sécurité,
          <strong>seuls les domaines se terminant par .gouv.fr sont automatiquement autorisés</strong>
          (à l'exception de .beta.gouv.fr). Les autres domaines sont soumis à
          une validation manuelle de notre part, merci de nous en faire la
          demande par mail à "
          <%= mail_to CONTACT_EMAIL, CONTACT_EMAIL, class: 'fr-link' %>
          <%= "." %>
        </p>
      <% end %>
    <% end %>
  <% elsif referentiel.url.present? || referentiel.url_tiptap.present? %>
    <div class="fr-mt-1w fr-message fr-message--info">
      Attention si vous appelez une API qui renvoie de la donnée personnelle,
      vous devez en informer votre DPO.
    </div>
  <% end %>
</div>
