#test-data-fields
  - if test_data_tags.present?
    .fr-table.fr-table--bordered.fr-table--no-caption.fr-mb-4w
      .fr-table__wrapper
        .fr-table__container
          .fr-table__content
            %table
              %thead
                %tr
                  %th.fr-py-2w Paramètre
                  %th.fr-py-2w Valeur de test
              %tbody
                - test_data_tags.each do |tag|
                  %tr
                    %td.fr-py-2w
                      %span.fr-tag.fr-tag--sm= tag[:label]
                    %td.fr-py-2w
                      %input.fr-input.fr-input--sm{ type: 'text', name: "referentiel[test_data_tiptap][#{tag[:id]}]", value: referentiel.test_data_tiptap&.dig(tag[:id]), placeholder: "ex : valeur de test" }
