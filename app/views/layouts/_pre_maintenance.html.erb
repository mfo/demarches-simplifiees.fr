<% banner = banner_for(:global) %>
<% if banner&.active? %>
  <%= render Dsfr::NoticeComponent.new(closable: false) do |c| %>
    <% c.with_title do %>
      <%= sanitize_banner(banner.content) %>
    <% end %>
  <% end %>
<% end %>

<% if instructeur_signed_in? %>
  <% banner = banner_for(:instructeurs_only) %>
  <% if banner&.active? %>
    <%= render Dsfr::NoticeComponent.new(closable: false) do |c| %>
      <% c.with_title do %>
        <%= sanitize_banner(banner.content) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% unless instructeur_signed_in? %>
  <% banner = banner_for(:usagers_only) %>
  <% if banner&.active? %>
    <%= render Dsfr::NoticeComponent.new(closable: false) do |c| %>
      <% c.with_title do %>
        <%= sanitize_banner(banner.content) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
