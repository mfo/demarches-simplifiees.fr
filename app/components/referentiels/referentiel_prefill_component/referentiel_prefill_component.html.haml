.fr-table.fr-table--bordered
  .fr-table__wrapper
    .fr-table__container
      .fr-table__content
        %table.referentiel-table
          %caption.fr-text--regular.fr-text--sm Indiquez les champs du formulaire usager qui doivent être préremplis avec les données issues du référentiel
          %thead
            %tr
              %th.fr-cell--fixed{ role: "columnheader" } Propriété
              %th{ scope: "col" } Exemple de donnée
              %th{ scope: "col" } Type de Donnée
              %th{ scope: "col" } Champ du formulaire usager à préremplir
          %tbody
            - referentiel_mapping_prefillable.sort.each do |jsonpath, mapping_opts|
              %tr
                %td.fr-cell--multiline.fr-cell--fixed.referentiel-cell-truncate{ title: jsonpath }= jsonpath
                %td.fr-cell--multiline.referentiel-cell-truncate{ title: mapping_opts[:example_value] }= mapping_opts[:example_value]
                %td= mapping_opts[:type]
                %td= prefill_stable_id_tag(jsonpath, mapping_opts)
          %tfoot
            %tr
              %td{ colspan: 4 }
                = render NestedForms::OwnedButtonComponent.new(formaction: reset_mapping_admin_procedure_referentiel_path(procedure, type_de_champ.stable_id, referentiel, scope: 'prefill'), http_method: :delete, opt: { class: "fr-link fr-link--sm fr-icon-delete-line fr-link--icon-left", data: { turbo_confirm: "Êtes-vous sûr de vouloir réinitialiser le préremplissage ?" } }) do
                  Réinitialiser le préremplissage
