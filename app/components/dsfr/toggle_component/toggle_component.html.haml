%div{ class: "fr-toggle #{extra_class_names}" }
  = @form.check_box target, { class: 'fr-toggle__input',id: label_for,disabled: disabled, checked: @checked }
  = @form.label target,
    title || html_title&.html_safe,
    for: label_for,
    data: label_data,
    class: 'fr-toggle__label'

  - if hint
    %p.fr-hint-text= hint
