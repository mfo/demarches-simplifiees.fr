.fr-px-2w
  - if @procedure.api_particulier_token.blank?
    = render Dsfr::AlertComponent.new(state: '', extra_class_names: 'fr-mb-3w fr-icon-lock-fill') do |c|
      - c.with_body do
        %p= t('.authorization_required_html')
        %p
          = t('.api_token_required_html')
          = link_to t('.api_tokens_link'), admin_procedure_jetons_path(@procedure), helpers.external_link_attributes

  %div{ class: class_names(inactive: @procedure.api_particulier_token.blank?) }
    %hr.fr-hr

    .fr-mb-1w.cell
      %p.fake-label.fr-text--bold.flex-grow.fr-mb-1v= t('.success_title')
      %p= t('.success_description', justificatif_label:)

    %hr.fr-hr

    .fr-mb-1w.cell
      %p.fake-label.fr-text--bold.flex-grow.fr-mb-1v= t('.failure_title')
      %p.fr-mb-0= t('.failure_description', justificatif_label:)

    .fr-notice.fr-notice--info.fr-mb-2w.fr-px-3w
      %p
        .fr-notice__title= t('.important_information')
        = t('.notice_intro')
        .notice__desc
          %ul.fr-mt-1v.fr-ml-4w
            - t(".notice_cases").each do |notice_case|
              %li= notice_case
