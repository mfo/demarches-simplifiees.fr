<nav
  class="fr-translate fr-nav"
  role="navigation"
  aria-label="<%= t('.my_account') %>"
>
  <div class="fr-nav__item">
    <button
      class="account-btn fr-translate__btn fr-btn"
      aria-controls="account"
      aria-expanded="false"
      title="<%= t('.my_account') %>"
    >
      <span class="fr-mr-1w"><%= current_email %></span>

      <%- if france_connected? -%>
        <span>&nbsp;<%= t('.via_france_connect') %></span>
      <%- end -%>

      <%- if show_profile_badge? -%>
        <span class="fr-badge fr-badge--sm <%= color_by_role(nav_bar_profile) %>">
          <%= t(nav_bar_profile, scope: :layouts) %>
        </span>
      <%- end -%>
    </button>

    <div id="account" class="fr-collapse fr-menu">
      <ul class="fr-menu__list max-content">
        <%- if multiple_devise_profile_connect? -%>
          <li>
            <%# TODO: this is a label, not a link. Rendering it as a span needs a visual check on the DSFR nav styles. %>
            <%= link_to "#", class: "fr-nav__link", "aria-current" => "true" do %>
              <%= t('.connected_as', profile: t(nav_bar_profile, scope: :layouts)) %>
            <% end %>
          </li>
          <%- switchable_profiles.each do |profile| -%>
            <li>
              <%= link_to switch_path_for(profile), class: "fr-nav__link" do %>
                <span>
                  <span class="fr-icon-refresh-line fr-icon--sm"></span>
                  <%= t(".go_#{profile}") %>
                </span>
              <% end %>
            </li>
          <%- end -%>
        <%- end -%>

        <%- if super_admin_signed_in? && nav_bar_profile != :superadmin -%>
          <li>
            <%= link_to manager_root_path, class: "fr-nav__link" do %>
              <span>
                <span class="fr-icon-shield-line fr-icon--sm"></span>
                <%= t('.go_superadmin') %>
              </span>
            <% end %>
          </li>
        <%- end -%>

        <li>
          <%= link_to profil_path(profil_path_params), class: "fr-nav__link" do %>
            <span>
              <span class="fr-icon-user-line fr-icon--sm"></span>
              <%= t('.profile') %>
            </span>
          <% end %>
        </li>

        <li>
          <%= link_to destroy_user_session_path, method: :delete, class: "fr-nav__link" do %>
            <span>
              <span class="fr-icon-logout-box-r-line fr-icon--sm"></span>
              <%= t('.logout') %>
            </span>
          <% end %>
        </li>
      </ul>
    </div>
  </div>
</nav>
