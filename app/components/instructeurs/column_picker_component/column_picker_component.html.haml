= form_with model: [:instructeur, @procedure_presentation], class: 'dropdown-form large columns-form' do
  %react-fragment.fr-mb-2v
    = render ReactComponent.new "Select/MultipleSelect", items: @displayable_columns_for_select, value: @displayable_columns_selected, name: 'displayed_columns[]', 'aria-label': 'Colonne à afficher'

  = submit_tag t('.save'), id: dom_id(@procedure_presentation, "submit"), class: 'fr-btn fr-btn--secondary'
